# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Better Auth
# Secret used by Better Auth
BETTER_AUTH_SECRET=""

# Drizzle
DATABASE_URL="postgresql://postgres:password@localhost:5432/find my mines"

# Optional integration verification: an existing Better Auth administrator.
GAME_TEST_ADMIN_EMAIL=""
GAME_TEST_ADMIN_PASSWORD=""

# Optional historical replay analysis (server only; both values enable generation).
# Choose an OpenAI model supporting Responses API structured outputs.
OPENAI_API_KEY=""
OPENAI_ANALYSIS_MODEL=""

# Production public origin (embedded in the browser during pnpm build)
# The production launcher listens on all IPv4 interfaces at this port.
# Set the IP to the address browsers use; do not use 0.0.0.0. Development uses localhost:3000.
# Optional public hostname, without http://, https://, a port, or a path; takes priority over IP.
NEXT_PUBLIC_PRODUCTION_DOMAIN=""
NEXT_PUBLIC_PRODUCTION_IP="127.0.0.1"
NEXT_PUBLIC_PRODUCTION_PORT="3000"
NEXT_PUBLIC_PRODUCTION_PROTOCOL="http"

# Optional direct HTTPS, runtime only. Set public protocol=https before building.
# Supply both PEM paths on the VPS; relative paths resolve beside server.js.
# Keep certificates/private keys outside the deployed bundle.
TLS_CERT_PATH=""
TLS_KEY_PATH=""
TLS_INTERNAL_PORT="5000"
# PORT overrides the public listener port at runtime; defaults to the public build port.

# Local migration helper: SSH target (user@host or an alias from ~/.ssh/config).
VPS_SSH_TARGET=""
# PostgreSQL address as reached FROM the VPS; use its database credentials.
VPS_DATABASE_URL=""
# Optional SSH port override; empty uses your SSH configuration.
VPS_SSH_PORT=""
# Local tunnel port; must be unused.
VPS_TUNNEL_PORT="15432"

# Optional bot play (reuses OPENAI_API_KEY; Responses model with structured outputs).
OPENAI_BOT_MODEL=""
