# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Better Auth
# Secret used by Better Auth
BETTER_AUTH_SECRET=""

# Drizzle
DATABASE_URL="postgresql://postgres:password@localhost:5432/find my mines"

# Local game operator (server only, at least 16 characters; no default password)
GAME_OPERATOR_PASSWORD=""

# Production IPv4 address and port (public; embedded in the browser during pnpm build)
# The production launcher listens on all IPv4 interfaces at this port.
# Set the IP to the address browsers use; do not use 0.0.0.0. Development uses localhost:3000.
NEXT_PUBLIC_PRODUCTION_IP="127.0.0.1"
NEXT_PUBLIC_PRODUCTION_PORT="3000"
